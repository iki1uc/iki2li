export async function loadChar(name) {
    try {
        const res = await fetch(`./CHAR/${name}.json`);
        if (!res.ok) return { ok: false, error: "Datei nicht gefunden" };

        const data = await res.json();

        if (!data.name || !data.home || !data.core) {
            return { ok: false, error: "Pflichtfelder fehlen" };
        }

        return {
            ok: true,
            id: data.id,
            name: data.name,
            home: data.home,
            active: data.active ?? false,
            core: data.core
        };

    } catch (err) {
        return { ok: false, error: err.toString() };
    }
}
